# Copy to stack.env, fill in values, and upload it in Portainer:
#   Stack > Environment variables > "Load variables from .env file"
# Never commit the filled-in file (this repo is public).

# Maintainerr: GitHub token (passed as GITHUB_TOKEN). Read-only public access is enough.
GITHUB_PAT=

# Tracearr
TRACEARR_DB_PASSWORD=
TRACEARR_JWT_SECRET=
TRACEARR_COOKIE_SECRET=
# Optional, defaults to *
# TRACEARR_CORS_ORIGIN=https://stats.mattyflix.com

# Discord role sync (discord-role-sync/README.md)
ROLE_SYNC_DISCORD_TOKEN=
ROLE_SYNC_PLEX_TOKEN=
ROLE_SYNC_SEERR_API_KEY=
# Leave true until the dry-run log looks right, then set to false
ROLE_SYNC_DRY_RUN=true
# Optional
# ROLE_SYNC_MAX_REMOVALS=5
# ROLE_SYNC_PROTECTED_IDS=123456789012345678,234567890123456789

# Tauticord (Discord sidebar stats)
TAUTICORD_DISCORD_TOKEN=
# Tautulli API key (Tautulli > Settings > Web Interface > API key)
TAUTICORD_TAUTULLI_KEY=

# Plex Rewind
PLEX_REWIND_NEXTAUTH_SECRET=

# Cloudflare DDNS: API token with Zone > DNS > Edit on mattyflix.com only
DDNS_CLOUDFLARE_TOKEN=
